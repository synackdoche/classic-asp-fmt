{
  "name": "classic-asp-fmt",
  "version": "0.1.0",
  "description": "Formatter for Classic ASP pages: a VBScript parser, and Prettier for the HTML, CSS and JavaScript around it.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "classic-asp-fmt": "out/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p .",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "test": "mocha",
    "pretest": "npm run build"
  },
  "dependencies": {
    "prettier": "^3.9.10",
    "vscode-html-languageservice": "^5.6.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  }
}
